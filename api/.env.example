# ─── Database ───────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/luxury_auto_db

# ─── Authentication ─────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ─── Google Sheets Sync ─────────────────────────
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Media Storage (Cloudflare R2 / S3) ─────────
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=luxury-showroom-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com

# ─── Email Notifications ────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-api-key
SALES_NOTIFICATION_EMAIL=sales@yourshowroom.com
ADMIN_ALERT_EMAIL=admin@yourshowroom.com

# ─── WhatsApp ────────────────────────────────────
WHATSAPP_NUMBER=971508919441

# ─── Frontend Revalidation ──────────────────────
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=your-revalidation-secret

# ─── Redis (BullMQ job queue) ────────────────────
REDIS_URL=redis://localhost:6379

# ─── Sentry Error Tracking ──────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ─── Server ──────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Optional: CRM Webhook ──────────────────────
CRM_WEBHOOK_URL=
